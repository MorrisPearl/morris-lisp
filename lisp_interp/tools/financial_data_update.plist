<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Mac's job that keeps morris_lisp/data/financial_data.db up to date: it runs examples/update_financial_data.lsp
  when you log in (RunAtLoad), and each day at 9:00 in the morning (StartCalendarInterval); if the Mac is asleep or off
  at 9:00, it runs when the Mac wakes. When the database is up to date the script stops in a second or two.
  economic_data_guide.md ("Keeping the database of market history up to date") says how to install and remove it.
  The paths are for /Users/morris; change them if the files are somewhere else.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.morris-lisp.financial-data-update</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/anaconda3/bin/python3</string>
        <string>/Users/morris/morris_lisp/lisp_interp/lisp_interpreter.py</string>
        <string>/Users/morris/morris_lisp/lisp_interp/examples/update_financial_data.lsp</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/morris/morris_lisp/lisp_interp</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/morris/Library/Logs/financial_data_update.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/morris/Library/Logs/financial_data_update.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
